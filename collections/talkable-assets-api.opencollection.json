{
  "opencollection": "1.0.0",
  "info": {
    "name": "Talkable Advocate Offers Assets API",
    "version": "2.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Assets",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List assets",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://www.talkable.com/api/v2/assets",
            "params": [
              {
                "name": "site_slug",
                "value": "my-store",
                "type": "query",
                "description": "Your Talkable Site ID. You can get this from your Talkable dashboard after you log in and create a site."
              },
              {
                "name": "content_type",
                "value": "",
                "type": "query",
                "description": "Filter by content type or its prefix, e.g. `image` or `image/png`."
              },
              {
                "name": "page",
                "value": "",
                "type": "query"
              },
              {
                "name": "per_page",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "List assets"
        },
        {
          "info": {
            "name": "Upload an asset",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://www.talkable.com/api/v2/assets",
            "params": [
              {
                "name": "site_slug",
                "value": "my-store",
                "type": "query",
                "description": "Your Talkable Site ID. You can get this from your Talkable dashboard after you log in and create a site."
              }
            ],
            "body": {
              "type": "multipart-form",
              "data": [
                {
                  "name": "file",
                  "type": "text",
                  "value": ""
                }
              ]
            }
          },
          "docs": "Upload an asset"
        },
        {
          "info": {
            "name": "Find an asset",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://www.talkable.com/api/v2/assets/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              },
              {
                "name": "site_slug",
                "value": "my-store",
                "type": "query",
                "description": "Your Talkable Site ID. You can get this from your Talkable dashboard after you log in and create a site."
              }
            ]
          },
          "docs": "Find an asset"
        }
      ]
    }
  ],
  "bundled": true
}