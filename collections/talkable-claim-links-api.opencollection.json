{
  "opencollection": "1.0.0",
  "info": {
    "name": "Talkable Advocate Offers Claim Links API",
    "version": "2.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Claim Links",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Check offer claim link status",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://www.talkable.com/api/v2/offers/:short_url_code/claim_url_status",
            "params": [
              {
                "name": "site_slug",
                "value": "my-store",
                "type": "query",
                "description": "Your Talkable Site ID. You can get this from your Talkable dashboard after you log in and create a site."
              },
              {
                "name": "short_url_code",
                "value": "",
                "type": "path"
              },
              {
                "name": "claim_url",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Check offer claim link status"
        }
      ]
    }
  ],
  "bundled": true
}